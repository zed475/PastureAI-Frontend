// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// User model for authentication and role-based access
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  name          String
  role          UserRole  @default(USER)
  phone         String?
  region        String?
  zone          String?
  woreda        String?
  organization  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  alerts         Alert[]
  reports        Report[]
  notifications  Notification[]

  @@index([email])
  @@index([role])
}

enum UserRole {
  USER        // Pastoralist/Community Member
  NGO         // NGO Worker
  GOVERNMENT  // Government Official
  ADMIN       // System Administrator
}

// NDVI data for vegetation monitoring
model NDVIData {
  id          Int      @id @default(autoincrement())
  region      String
  zone        String?
  woreda      String?
  latitude    Float
  longitude   Float
  ndviValue   Float
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([region, date])
  @@index([woreda, date])
}

// Weather data for climate monitoring
model WeatherData {
  id          Int      @id @default(autoincrement())
  region      String
  zone        String?
  woreda      String?
  temperature Float?
  humidity    Float?
  rainfall    Float?
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([region, date])
}

// Livestock condition reports
model LivestockReport {
  id            Int       @id @default(autoincrement())
  userId        Int
  user         User      @relation(fields: [userId], references: [id])
  region        String
  zone          String
  woreda        String
  livestockType String    // cattle, camel, goat, sheep
  condition     ConditionStatus
  bodyScore     Int?     // 1-5 scale
  population    Int?
  mortalityRate Float?
  reportDate    DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, reportDate])
  @@index([region, woreda])
}

enum ConditionStatus {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

// Alert system for early warnings
model Alert {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  type        AlertType
  severity    SeverityLevel
  region      String
  zone        String?
  woreda      String?
  isActive    Boolean     @default(true)
  userId      Int?
  user        User?       @relation(fields: [userId], references: [id])
  issuedAt    DateTime    @default(now())
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([type, severity])
  @@index([region, isActive])
}

enum AlertType {
  DROUGHT
  FLOOD
  DISEASE_OUTBREAK
  PEST_INFESTATION
  RESOURCE_CONFLICT
  MARKET_CRISIS
  NDVI_ANOMALY
  WEATHER_EXTREME
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Reports generated by the system
model Report {
  id          Int       @id @default(autoincrement())
  title       String
  type        ReportType
  content     String    @db.Text
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  region      String
  period      String    // weekly, monthly, quarterly
  generatedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([userId, type])
  @@index([region, period])
}

enum ReportType {
  SITUATION_ANALYSIS
  EARLY_WARNING
  IMPACT_ASSESSMENT
  RESPONSE_PLAN
  TREND_ANALYSIS
}

// Notifications for users
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// Resource inventory (water points, grazing areas, etc.)
model Resource {
  id          Int           @id @default(autoincrement())
  name        String
  type        ResourceType
  region      String
  zone        String
  woreda      String
  latitude    Float
  longitude   Float
  capacity    Float?
  status      ResourceStatus
  lastUpdated DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([type, region])
  @@index([woreda])
}

enum ResourceType {
  WATER_POINT
  GRAZING_AREA
  LIVESTOCK_MARKET
  VETERINARY_CLINIC
  FEED_STORAGE
  EMERGENCY_SHELTER
}

enum ResourceStatus {
  OPERATIONAL
  DEGRADED
  NON_FUNCTIONAL
  UNKNOWN
}
